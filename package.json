{
  "name": "sankofa-react-native",
  "version": "1.0.1",
  "description": "Sankofa Analytics SDK for React Native — event tracking, heatmaps, session replay.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "ios/*.swift",
    "ios/*.h",
    "ios/*.m",
    "ios/*.mm",
    "android/src",
    "android/build.gradle",
    "*.podspec",
    "expo-module.config.json",
    "app.plugin.js",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "clean": "rm -rf node_modules"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testRegex": "test/.*\\.test\\.ts$",
    "moduleNameMapper": {
      "^expo-modules-core$": "<rootDir>/test/__mocks__/expo-modules-core.ts",
      "^react-native$": "<rootDir>/test/__mocks__/react-native.ts"
    },
    "transform": {
      "^.+\\.(ts|tsx)$": ["ts-jest", { "tsconfig": { "jsx": "react" } }]
    },
    "globals": {
      "__DEV__": true
    }
  },
  "keywords": [
    "react-native",
    "analytics",
    "heatmap",
    "session-replay",
    "sankofa",
    "expo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sankofa-HQ/sankofa_sdk_react_native.git"
  },
  "homepage": "https://sankofa.dev",
  "license": "MIT",
  "peerDependencies": {
    "expo-modules-core": ">=1.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.73.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.28",
    "@types/react-native": "^0.73.0",
    "expo-modules-core": "^2.3.0",
    "jest": "^29.7.0",
    "react": "^18.3.1",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.3"
  }
}
