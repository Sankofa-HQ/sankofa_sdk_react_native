# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/

# ─── TypeScript / JS build output ────────────────────────────────────────────
dist/
lib/
*.tsbuildinfo

# ─── iOS ────────────────────────────────────────────────────────────────────
# SankofaIOS sources are copied in by SankofaReactNative.podspec's
# prepare_command at install time — never commit the copy.
ios/SankofaIOS/

# Swift Package Manager (left over if anyone runs `swift build` here)
.build/
.swiftpm/
Package.resolved

# CocoaPods + Xcode build outputs
ios/Pods/
ios/build/
ios/DerivedData/
ios/*.xcworkspace/xcuserdata/
ios/*.xcodeproj/xcuserdata/
ios/*.xcodeproj/project.xcworkspace/xcuserdata/
xcuserdata/
*.xcuserstate
*.xcuserdatad/

# iOS signing / secrets
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# ─── Android ────────────────────────────────────────────────────────────────
android/build/
android/.gradle/
android/.cxx/
android/.kotlin/
android/local.properties
android/captures/
android/.idea/
*.aar
*.ap_

# ─── Expo / Metro ───────────────────────────────────────────────────────────
.expo/
.metro-health-check*

# ─── IDE ────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.iml

# ─── OS ─────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.history/

# ─── Logs / debug ───────────────────────────────────────────────────────────
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# ─── Misc ───────────────────────────────────────────────────────────────────
*.orig.*
*.app
*.ipa
*.apk
